<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred device-to-device: accounts reference Keystore keys that
  cannot be restored, and call history / contacts are personal data. Re-provision with a new link.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
