<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash (core-splashscreen back-port for Android 10/11, native on 12+). -->
    <style name="Theme.Ivrtop.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Ivrtop</item>
    </style>

    <style name="Theme.Ivrtop" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
